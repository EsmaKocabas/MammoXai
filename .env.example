# Veritabanı Bağlantısı (NeonDB / PostgreSQL)
DATABASE_URL=postgresql://username:password@your-neon-host.aws.neon.tech/neondb?sslmode=require

# JWT Yapılandırması
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Sunucu Ayarları
PORT=5001
NODE_ENV=development

# AI Model Servisi (backend/ai_model/app.py)
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000
# MODEL_VERSION en fazla 30 karakter olmalı (analyses.model_version VARCHAR(30))
MODEL_VERSION=efficientnet_b4_final_best

# Risk seviyesi eşikleri (malign olasılığı 0-1) - klinik kalibrasyona göre ayarlayın
RISK_LOW_MAX=0.3
RISK_HIGH_MIN=0.7
