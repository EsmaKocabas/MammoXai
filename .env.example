# Veritabanı Bağlantısı (NeonDB / PostgreSQL)
DATABASE_URL=postgresql://username:password@your-neon-host.aws.neon.tech/neondb?sslmode=require

# JWT Yapılandırması
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Sunucu Ayarları
PORT=5001
NODE_ENV=development

# AI Model Servisi (backend/ai_model/app.py)
# Docker'da otomatik ayarlanır, lokal geliştirmede şu adresi kullanın:
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000
# MODEL_VERSION en fazla 30 karakter olmalı (analyses.model_version VARCHAR(30))
MODEL_VERSION=efficientnet_b4_final_best

# Risk seviyesi eşikleri (malign olasılığı 0-1) - klinik kalibrasyona göre ayarlayın
RISK_LOW_MAX=0.3
RISK_HIGH_MIN=0.7

# SMTP E-posta Ayarları (Şifre sıfırlama vb. için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL (Backend → Frontend yönlendirmeler için)
FRONTEND_URL=http://localhost:5173
